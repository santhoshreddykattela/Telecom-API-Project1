    {
      "name": "01 Add User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const uniqueEmail = `test${Date.now()}@fake.com`;\r",
              "\r",
              "pm.environment.set(\"email\", uniqueEmail);\r",
              "pm.environment.set(\"password\", \"myPassword123\");\r",
              "console.log(\"EMAIL:\", pm.environment.get(\"email\"));\r",
              "console.log(\"PASSWORD:\", pm.environment.get(\"password\"));\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.environment.set(\"token\", response.token);\r",
              "\r",
              "pm.test(\"Token is generated\", function () {\r",
              "    pm.expect(response.token).to.not.be.empty;\r",
              "});\r",
              "\r",
              "console.log(\"TOKEN SAVED:\", pm.environment.get(\"token\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstName\": \"Test\",\r\n    \"lastName\": \"User\",\r\n    \"email\": \"{{email}}\",\r\n    \"password\": \"{{password}}\"\r\n}",
          "options": {
